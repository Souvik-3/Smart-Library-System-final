<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrary.controller.LibrarianController">
    <TabPane AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" tabClosingPolicy="UNAVAILABLE">
        <Tab text="About System">
            <ScrollPane fitToWidth="true" style="-fx-padding: 20;">
                <Label wrapText="true" style="-fx-font-size: 15px; -fx-line-spacing: 5px; -fx-padding: 10;" text="The Smart Library Management System is a JavaFX-based desktop application designed to simplify and manage the daily activities of a library. The system provides separate functionalities for Librarians and Students/Members, ensuring that each user can perform only the tasks relevant to their role.&#10;&#10;The librarian can manage books and library members, including adding, editing, searching, and removing book records, registering members, and managing book availability. The librarian can also issue books to members and process returned books. The system automatically updates the status of a book from Available to Issued and vice versa.&#10;&#10;Students or members can log into the system to view their profile, search for available books, view book details, and check their currently borrowed books and borrowing history. They cannot directly add books or perform issue/return operations.&#10;&#10;The application will provide a user-friendly graphical interface using JavaFX components such as TextField, PasswordField, ComboBox, ChoiceBox, RadioButton, CheckBox, DatePicker, TextArea, ImageView, TableView, ListView, Alert, MenuBar, and FileChooser. The project will also demonstrate event handling, scene switching, FXML-based interface design, and structured application development using the MVC approach.&#10;&#10;Overall, the system aims to provide a simple, realistic, and efficient solution for managing library resources and member activities through a modern graphical user interface." />
            </ScrollPane>
        </Tab>
        <Tab text="Manage Books">
            <VBox spacing="10" style="-fx-padding: 10;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Librarian Dashboard - Books" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Logout" onAction="#handleLogout" />
                </HBox>
                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="Search books by title or author" prefWidth="300"/>
                    <Button text="Search" onAction="#handleSearch"/>
                </HBox>
                <TableView fx:id="bookTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="100" />
                        <TableColumn fx:id="colTitle" text="Title" prefWidth="250" />
                        <TableColumn fx:id="colAuthor" text="Author" prefWidth="200" />
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100" />
                        <TableColumn fx:id="colIssuedTo" text="Issued To" prefWidth="100" />
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="bookIdField" promptText="Book ID" />
                    <TextField fx:id="titleField" promptText="Title" />
                    <TextField fx:id="authorField" promptText="Author" />
                    <Button text="Add Book" onAction="#handleAddBook" />
                    <Button text="Edit Selected" onAction="#handleEditBook" />
                    <Button text="Remove Book" onAction="#handleRemoveBook" />
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="issueToField" promptText="Student ID" />
                    <Button text="Issue Book" onAction="#handleIssueBook" />
                    <Button text="Return Book" onAction="#handleReturnBook" />
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Manage Members">
            <VBox spacing="10" style="-fx-padding: 10;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Librarian Dashboard - Members" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                </HBox>
                <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMemberId" text="ID" prefWidth="100" />
                        <TableColumn fx:id="colMemberName" text="Name" prefWidth="250" />
                        <TableColumn fx:id="colMemberRole" text="Role" prefWidth="150" />
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="newMemberIdField" promptText="Member ID" />
                    <TextField fx:id="newMemberNameField" promptText="Name" />
                    <PasswordField fx:id="newMemberPassField" promptText="Password" />
                    <ChoiceBox fx:id="newMemberRoleBox" />
                    <Button text="Register Member" onAction="#handleRegisterMember" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</AnchorPane>

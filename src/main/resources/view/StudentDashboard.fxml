<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrary.controller.StudentController" prefWidth="1200" prefHeight="700">
    
    <!-- Top Header Section -->
    <top>
        <VBox>
            <!-- Green Gradient Banner -->
            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: linear-gradient(to bottom, #c5e1a5, #7cb342); -fx-padding: 15;">
                <Label text="CENTRAL LIBRARY" style="-fx-font-size: 28px; -fx-text-fill: #1a4314; -fx-font-weight: bold;" />
                <Label text="Welcome to Online Public Access Catalogue (OPAC)" style="-fx-font-size: 16px; -fx-text-fill: #1a4314; -fx-font-style: italic;" />
                <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #1a4314; -fx-underline: true; -fx-cursor: hand;" translateY="-40" translateX="550" />
            </VBox>
            
            <!-- Search Bar Area -->
            <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <ChoiceBox fx:id="searchChoice" value="Library catalog" prefWidth="130" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 3;" />
                <TextField fx:id="searchField" promptText="Search the catalog by keyword" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 3; -fx-padding: 5;" />
                <Button text="Q" onAction="#handleSearch" style="-fx-background-color: #558b2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>
            
            <!-- Breadcrumbs / Links -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 15; -fx-background-color: white;">
                <Label text="Advanced search | Authority search | Tag cloud | Library" style="-fx-text-fill: #2980b9; -fx-cursor: hand;" />
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 5 15; -fx-background-color: #f9f9f9; -fx-border-color: #eee; -fx-border-width: 1 0;">
                <Label text="Home" style="-fx-text-fill: #2980b9;" />
                <Label text="›" />
                <Label fx:id="breadcrumbNameLabel" text="USER" style="-fx-text-fill: #2980b9;" />
                <Label text="›" />
                <Label text="Your summary" />
            </HBox>
        </VBox>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox spacing="2" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #eee; -fx-border-width: 0 1 0 0;" prefWidth="220">
            <Button text="Summary" onAction="#handleSidebarClick" userData="Summary" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: white; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Charges" onAction="#handleSidebarClick" userData="Charges" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Personal details" onAction="#handleSidebarClick" userData="Personal details" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Tags" onAction="#handleSidebarClick" userData="Tags" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Change password" onAction="#handleSidebarClick" userData="Change password" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Checkout history" onAction="#handleSidebarClick" userData="Checkout history" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Purchase suggestions" onAction="#handleSidebarClick" userData="Purchase suggestions" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Messaging" onAction="#handleSidebarClick" userData="Messaging" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
            <Button text="Lists" onAction="#handleSidebarClick" userData="Lists" maxWidth="Infinity" alignment="BASELINE_LEFT" style="-fx-background-color: #f9f9f9; -fx-text-fill: #2980b9; -fx-border-color: #eee; -fx-padding: 10;" />
        </VBox>
    </left>
    
    <!-- Center Main Content -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
            
            <Label text="Your summary" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />
            
            <VBox spacing="2">
                <Label fx:id="welcomeLabel" text="Hello, USER" style="-fx-font-weight: bold; -fx-text-fill: #333;" />
                <Label text="Click here if you're not this user" style="-fx-text-fill: #2980b9; -fx-cursor: hand;" onMouseClicked="#handleLogout" />
            </VBox>
            
            <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white; -fx-border-color: #ddd;">
                
                <!-- Checked Out Tab -->
                <Tab fx:id="checkedOutTab" text="Checked out">
                    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
                        
                        <!-- Top Toolbar -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Search" style="-fx-text-fill: #666;" />
                            <TextField prefWidth="150" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 3;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✓ Renew selected" onAction="#handleReturnBook" style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand;" />
                            <Button text="✓ Renew all" onAction="#handleReturnBook" style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand;" />
                        </HBox>
                        
                        <Label fx:id="checkedOutCountLabel" text="X Item(s) checked out" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                        
                        <!-- Borrowed Table (Mimicking OPAC format) -->
                        <TableView fx:id="borrowedTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #eee;">
                            <columns>
                                <TableColumn fx:id="colBorrTitle" text="Title" prefWidth="300" />
                                <TableColumn fx:id="colBorrAuthor" text="Author" prefWidth="180" />
                                <TableColumn fx:id="colBorrDue" text="Due" prefWidth="100" />
                                <TableColumn fx:id="colBorrCall" text="Call number" prefWidth="100" />
                                <TableColumn fx:id="colBorrRenew" text="Renew" prefWidth="180" />
                                <TableColumn fx:id="colBorrFines" text="Fines" prefWidth="60" />
                            </columns>
                        </TableView>
                        
                        <!-- Bottom Toolbar -->
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Button text="Renew selected" onAction="#handleReturnBook" style="-fx-background-color: #558b2f; -fx-text-fill: white; -fx-cursor: hand;" />
                            <Button text="Renew all" onAction="#handleReturnBook" style="-fx-background-color: #558b2f; -fx-text-fill: white; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                </Tab>

                <!-- Search Results / Available Books Tab -->
                <Tab fx:id="availableBooksTab" text="Available Books (Search)">
                    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
                        <Label text="Search Results" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                        <TableView fx:id="availableTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #eee;">
                            <columns>
                                <TableColumn fx:id="colAvailTitle" text="Title" prefWidth="350" />
                                <TableColumn fx:id="colAvailAuthor" text="Author" prefWidth="250" />
                                <TableColumn fx:id="colAvailStatus" text="Status" prefWidth="150" />
                            </columns>
                        </TableView>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Button text="Borrow Selected" onAction="#handleBorrowBook" style="-fx-background-color: #558b2f; -fx-text-fill: white; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                </Tab>

            </TabPane>
        </VBox>
    </center>
    
</BorderPane>
